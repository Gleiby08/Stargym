PORT=3000
APP_BASE_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters

MONGODB_URI=
MONGODB_DB_NAME=Stargym
MONGODB_USERS_COLLECTION=users

# Correo de la cuenta con acceso al panel /admin.
ADMIN_EMAIL=

# PayPal REST app credentials. Start with sandbox; use live only after testing.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Binance Pay merchant API credentials.
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=
