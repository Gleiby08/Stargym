PORT=3000
APP_BASE_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters

MONGODB_URI=
MONGODB_DB_NAME=Stargym
MONGODB_USERS_COLLECTION=users

# Gmail API over HTTPS (works on Render Free; see README for OAuth setup).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
FROM_EMAIL="Stargym <your-email@gmail.com>"

# SMTP fallback for deployments that allow outbound SMTP.
# For Gmail, use a Google App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Correo de una cuenta existente y verificada con acceso al panel /admin.
ADMIN_EMAIL=

# Resend HTTP API (takes priority over Gmail API if configured).
RESEND_API_KEY=

# PayPal REST app credentials. Start with sandbox; use live only after testing.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Binance Pay merchant API credentials.
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=
